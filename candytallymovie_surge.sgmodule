#!name=Header Rewrite (Surge/Loon)
#!desc=Header Rewrite for candytallymovie.vip
#!system=ios

[Header Rewrite]
# 直接使用 Surge 原生的 Header Rewrite 功能，不依赖 JS 脚本
# 语法：域名 匹配字段 替换字段 值
# 如果是修改 User-Agent
^https?://.*candytallymovie\.vip header-replace User-Agent "Filebar/1.4.6"

# 如果是添加/修改自定义 Header (X-Emby-Authorization)
# Surge 的 header-replace 可能只对标准 header 有效，对于自定义 header，通常使用 header-add 或 header-del
^https?://.*candytallymovie\.vip header-del X-Emby-Authorization
^https?://.*candytallymovie\.vip header-add X-Emby-Authorization 'MediaBrowser Token="", UserId="04F1CE9B-3437-4406-9AD8-01C79A59C2CE", Client="Filebar", Device="iPhone", DeviceId="0D8371E5-5128-4226-9B1A-2F596D2D8311", Version="1.4.6"'

[MITM]
hostname = %APPEND% *.candytallymovie.vip, candytallymovie.vip
